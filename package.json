{
  "name": "pure-canada-website",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install --prefix client --legacy-peer-deps && npm install --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "build": "npm run install:all && npm run build --prefix client",
    "start": "npm start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
